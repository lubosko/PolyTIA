<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaBridge</RootNamespace>
    <AssemblyName>TiaBridge</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- App.config must be named app.config (lowercase) for SDK-style projects -->
  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Framework references needed for .NET 4.8 SDK-style project -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Newtonsoft.Json via NuGet -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    V20 PublicAPI ships only 2 DLLs (Compiler + ExportImport merged into main assembly).
    Add references in Visual Studio:
      Project → Add Reference → Browse →
      C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\
      Select BOTH files, set Copy Local = false.
  -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
